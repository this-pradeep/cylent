---
const links = [
  { href: '#services', label: 'Services' },
  { href: '#work', label: 'Work' },
  { href: '#process', label: 'Process' },
  { href: '#contact', label: 'Contact' },
];
---
<header class="fixed top-0 inset-x-0 z-50 bg-bg/80 backdrop-blur">
  <nav class="max-w-[1400px] mx-auto px-6 h-20 flex items-center justify-between">
    <a href="#top" class="text-xl font-medium tracking-tight">Cylent</a>
    <ul class="hidden md:flex gap-8 text-sm text-ink/70">
      {links.map((link) => (
        <li><a href={link.href} class="hover:text-ink transition-colors">{link.label}</a></li>
      ))}
    </ul>
    <a
      href="#contact"
      class="rounded-full bg-ink text-bg text-sm px-5 py-2 hover:bg-accent transition-colors"
    >
      Start a project
    </a>
  </nav>
</header>
