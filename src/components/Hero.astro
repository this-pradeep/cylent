<section id="top" data-hero class="relative overflow-hidden min-h-screen flex items-center pt-20">
  <div data-hero-bg class="absolute inset-0 -z-10 bg-gradient-to-b from-bg to-bg/80"></div>
  <div data-hero-accent class="absolute -right-24 top-1/3 h-72 w-72 rounded-full bg-accent/20 blur-3xl -z-10"></div>
  <div class="max-w-[1400px] mx-auto px-6">
    <h1 class="text-6xl md:text-8xl font-medium leading-[1.05] tracking-tight">
      <span data-hero-word class="inline-block">Premium</span>
      <span data-hero-word class="inline-block">digital</span>
      <span data-hero-word class="inline-block">craft,</span><br />
      <span data-hero-word class="inline-block">built</span>
      <span data-hero-word class="inline-block">to</span>
      <span data-hero-word class="inline-block">move.</span>
    </h1>
    <p class="mt-6 max-w-xl text-lg text-ink/70">
      Cylent designs and builds premium web experiences, video, and graphics for brands
      that don't settle for default.
    </p>
  </div>
</section>
