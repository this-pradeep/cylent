---
import { getCollection, render } from 'astro:content';
import ServiceScene from '../islands/ServiceScene';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(services.map((entry) => render(entry)));
---
<section id="services" class="py-32">
  <div class="max-w-[1400px] mx-auto px-6 space-y-32">
    {services.map((service, i) => {
      const sectionId = `service-${service.data.variant}`;
      const { Content } = rendered[i];
      return (
        <div id={sectionId} class="grid md:grid-cols-2 gap-12 items-center min-h-[80vh]">
          <div>
            <h3 class="text-3xl font-medium">{service.data.title}</h3>
            <p class="mt-4 text-ink/70">{service.data.shortDescription}</p>
            <div class="mt-6 text-ink/70"><Content /></div>
          </div>
          <div class="h-[420px]">
            <ServiceScene client:visible variant={service.data.variant} sectionId={sectionId} />
          </div>
        </div>
      );
    })}
  </div>
</section>
